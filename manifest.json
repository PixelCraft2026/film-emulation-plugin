{
  "id": "com.cheukwing.filmhalation",
  "name": "Film Halation",
  "version": "1.5.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0"
  },
  "manifestVersion": 4,
  "entrypoints": [
    {
      "type": "panel",
      "id": "filmHalationPanel",
      "label": {
        "default": "Film Halation"
      },
      "minimumSize": { "width": 300, "height": 400 },
      "maximumSize": { "width": 800, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 480 },
      "preferredFloatingSize": { "width": 320, "height": 480 }
    }
  ]
}
